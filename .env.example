# Proveedor de datos activo: osm | google  (Fase 0: solo 'osm')
VITE_PROVIDER=osm

# OpenRouteService: necesario para tiempos reales a pie/bici/carro (Fase 2).
# Gratuita en https://openrouteservice.org/dev/#/signup
# Sin esta key la app usa estimaciones (distancia recta x 1.3) y lo marca en la UI.
VITE_ORS_API_KEY=

# Transporte público (Fase 2). Instancia pública VBB: Berlín-Brandenburg.
VITE_TRANSIT_BASE_URL=https://v6.vbb.transport.rest

# Autocompletado de direcciones (Fase 1).
VITE_PHOTON_URL=https://photon.komoot.io

# Geocodificación inversa (Fase 1). Máx. 1 req/s.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Lugares cercanos (Fase 3).
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Mapa base: osm | esri | carto
#   osm   (por defecto) tiles de OpenStreetMap, sin key.
#   esri  World Light Gray Canvas, sin key: base apagada, marcadores más visibles.
#   carto Positron: base clara y sobria, pero exige API key propia (ver abajo).
VITE_TILE_SOURCE=osm

# Sólo si usas VITE_TILE_SOURCE=carto. Sin ella los tiles salen con la marca
# de agua "API KEY REQUIRED".
VITE_CARTO_API_KEY=
